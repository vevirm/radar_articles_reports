{
  "target_words": 10000,
  "hard_max_words": 12000,
  "min_words": 8,
  "include_globs": [
    "*.html",
    "**/*.html",
    "*.md",
    "**/*.md",
    "assets/site-data.js",
    "assets/radar-wisdom.json",
    "assets/research-radar-approved.json"
  ],
  "exclude_globs": [
    ".github/**",
    "language-inbox/**",
    "language-outbox/**",
    "language-archive/**",
    "language/**",
    "tests/**",
    "scripts/**",
    "radar-candidates/README.md",
    "README.md",
    "README-REPAIR.txt",
    "README_SAFE_ADDON.txt",
    "radar_criteria.md",
    "radar-candidates/**"
  ],
  "html_tags": [
    "p",
    "h1",
    "h2",
    "h3",
    "h4",
    "li",
    "blockquote"
  ],
  "data_keys": [
    "bio",
    "tagline",
    "summary",
    "description",
    "text",
    "comment",
    "commentary",
    "why",
    "rationale",
    "explanation",
    "implication",
    "implications",
    "note",
    "excerpt"
  ],
  "light_mode_paths": [
    "assets/research-radar-approved.json",
    "radar-candidates/**",
    "research-radar.html"
  ]
}
